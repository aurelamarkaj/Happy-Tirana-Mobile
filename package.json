{
  "name": "happy-tirana-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/expo-local.cjs start",
    "android": "node scripts/expo-local.cjs start --android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:android": "node scripts/expo-local.cjs export --platform android",
    "expo:check": "node scripts/expo-local.cjs install --check",
    "android:prebuild": "node scripts/expo-local.cjs prebuild --platform android --no-install",
    "android:doctor": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-doctor.ps1",
    "android:keystore": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-keystore.ps1",
    "android:apk": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "android:keystore:mac": "bash scripts/create-keystore-macos.sh",
    "android:apk:mac": "bash scripts/build-apk-macos.sh"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.0",
    "expo": "57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "lucide-react-native": "1.50.0",
    "query-string": "7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.65.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "^1.27.2",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "^0.10.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "query-string": "7.1.3",
    "uuid": "11.1.1"
  }
}
