# URL HTTPS e API-se ekzistuese; pa slash ne fund. Mos vendos token ketu.
EXPO_PUBLIC_API_BASE_URL=
# URL te plota HTTPS te faqeve web per secilin rol.
EXPO_PUBLIC_RIDER_RESET_PASSWORD_URL=
EXPO_PUBLIC_BUSINESS_RESET_PASSWORD_URL=
# Path-i i Socket.IO ne proxy; serveri ekzistues perdor /socket.io.
EXPO_PUBLIC_SOCKET_PATH=/socket.io
# Maps SDK per Android; key i kufizuar per package dhe SHA-1 te signing.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
# Regjistron pajisjen e motoristit te PUT /riders/me/devices.
EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION=true
# Opsionale: UUID-ja reale është e lidhur në app.config.ts. Përdoret vetëm për override.
EXPO_PUBLIC_EXPO_PROJECT_ID=0d8c3c87-6979-476e-a195-6f1edb17081d
